<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiUiApp.AuthPage"
             Title="AuthPage">
    <VerticalStackLayout
        Padding="30,0"
        Spacing="25">

        <Button x:Name="AuthButton"
            Text="Авторизоваться"
            Grid.Column="0"
            Command="{Binding AuthCommand}"
            BackgroundColor="#0078D4"
            TextColor="White"/>

        <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
            <Label Text="URL:  " FontSize="16"/>
            <Label Text="{Binding UrlAuth}" FontSize="16" TextColor="Blue">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenUrlCommand}" 
                                  CommandParameter="{Binding UrlAuth}"/>
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>

        <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
            <Label Text="User Code:  " FontSize="16"/>
            <Label Text="{Binding UserCode}" FontSize="16"/>
        </StackLayout>

    </VerticalStackLayout>
</ContentPage>